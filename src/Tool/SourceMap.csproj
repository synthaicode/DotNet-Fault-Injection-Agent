<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DotNetFaultInjectionAgent.Tool</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
    <PackageId>DotNetFaultInjectionAgent.Tool</PackageId>
    <ToolCommandName>dotnet-fault-injection</ToolCommandName>
    <Version>0.1.0</Version>
    <PackageReleaseNotes>Initial release: AI planning guide, verified injection plans and bundled Windows/Linux x64 execution payloads. Requires .NET 10 for the CLI; see README for target runtime support and limitations.</PackageReleaseNotes>
    <Description>Fault injection planning CLI with bundled Windows and Linux x64 runtimes. Supports .NET Framework 4.8 on Windows x64 for dedicated fixtures and the order host. General compatibility with arbitrary existing .NET Framework applications is not guaranteed. Windows services require service-specific startup configuration. .NET 10 on Windows x64 is supported for the dedicated CoreFileTarget fixture only. .NET 8 on Linux x64 supports generic external-call injection. The CLI requires .NET 10 (net10.0); target applications can keep their supported runtime. net48 is a fault injection target within the stated scope and is not a CLI target framework.</Description>
    <Authors>synthaicode</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/synthaicode/DotNet-Fault-Injection-Agent</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/synthaicode/DotNet-Fault-Injection-Agent</PackageProjectUrl>
    <!-- The .NET tool exports this script explicitly; it is not a NuGet install.ps1 hook. -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>
    <PackageTags>dotnet;fault-injection;testing;ai-assist;dotnet-framework;net48</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../artifacts/runtime/win-x64/*" Link="runtime/win-x64/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <Content Include="../../artifacts/runtime/linux-x64/*" Link="runtime/linux-x64/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <EmbeddedResource Include="AI-plan-guide.md" LogicalName="DotNetFaultInjectionAgent.AI-plan-guide.md" />
    <None Update="AI-plan-guide.md" Pack="true" PackagePath="/AI-plan-guide.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../docs/packaging/nuget-readme.md" Pack="true" PackagePath="/README.md" />
    <None Include="../../docs/packaging/Roslyn.LICENSE.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../docs/packaging/Roslyn.ThirdPartyNotices.rtf" Pack="true" PackagePath="licenses/" />
    <None Include="../../schemas/injection-plan.v3.schema.json" Pack="true" PackagePath="schemas/" />
    <ProjectReference Include="../Planner/Planner.csproj" />
    <!-- SDK compiler binaries can contain host-specific ReadyToRun code. Use portable package assets. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>
  <Target Name="RequireWindowsRuntime" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../../artifacts/runtime/win-x64/manifest.json')" Text="Build and stage the Windows runtime with tools/Stage-WindowsRuntime.ps1 before packing." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../../artifacts/runtime/linux-x64/manifest.json')" Text="Build and stage the Linux runtime before packing." />
  </Target>
</Project>
